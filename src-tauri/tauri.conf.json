{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stream",
  "version": "0.1.1",
  "identifier": "com.pleiades.stream",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stream",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["stream"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "nsis/sidebar.bmp",
        "headerImage": "nsis/header.bmp",
        "uninstallerHeaderImage": "nsis/uninstallerHeader.bmp",
        "installerHooks": "nsis/hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}
